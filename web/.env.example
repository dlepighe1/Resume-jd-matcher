# Copy to .env.local and fill in. .env.local is gitignored, so real keys are never committed.
#
# Both variables are optional. With neither set, the demo page still renders the precomputed
# benchmark, which is the part backed by published evidence. Live scoring is disabled and the
# page says so rather than failing.

# --- Fine-tuned scoring service (Python, FastAPI) ---
# Enables live scoring and the base-model comparison.
# http://localhost:8000 for local development, or your Railway service URL in production.
SCORING_SERVICE_URL=http://localhost:8000
# Optional. Must equal PROXY_SECRET on the scoring service. Lets the service rate limit each
# visitor separately; without it, everyone using the deployed page shares one budget.
SCORING_SERVICE_SECRET=

# --- Claude (optional) ---
# Adds Claude as a third engine in the live comparison. Each request costs an API call, so it
# is opt-in per scoring run rather than always on.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-4-8. Use claude-sonnet-5 for roughly 3x cheaper inference.
ANTHROPIC_MODEL=claude-opus-4-8
