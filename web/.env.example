# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# Each provider only needs its own keys: the app runs fine with just ANTHROPIC_API_KEY set.

# --- Claude provider ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-4-8. Use claude-sonnet-5 for ~3x cheaper inference.
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenRouter provider (free open-weights model) ---
OPENROUTER_API_KEY=sk-or-...
# Required, no default: free slugs rotate and get retired. Pick a current one
# from https://openrouter.ai/models?q=free
OPENROUTER_MODEL=

# --- Fine-tuned provider (Python FastAPI service) ---
# http://localhost:8000 for local dev, or your HuggingFace Space URL in production.
SCORING_SERVICE_URL=http://localhost:8000

# --- Supabase (shareable links) ---
SUPABASE_URL=https://<project>.supabase.co
# Server-side only. Never expose the service-role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (auth). Create an app at https://dashboard.clerk.com, enable Google + email.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# There is no "/" route; send users to the matcher after auth.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/matcher
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/matcher
